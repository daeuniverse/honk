# dae lab config for 10.10.10.118 (NanoPi R2S) — mirrors the ARM honk lab.
# Semantics cover the shared hy2/tuic/ss2022/trojan protocol set.
global {
    wan_interface: eth0
    lan_interface: veth-lab
    log_level: info
    dial_mode: ip
    allow_insecure: true
    auto_config_kernel_parameter: true
    disable_waiting_network: true
    tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 3600s
    check_tolerance: 30ms
}

node {
    hy2: 'hysteria2://testpass123@10.10.10.70:8443/?insecure=1'
    tuic: 'tuic://00000000-0000-0000-0000-000000000001:testpass123@10.10.10.70:2444/?congestion_control=cubic&alpn=tuic&sni=hy2.test&allow_insecure=1'
    ss2022: 'ss://2022-blake3-aes-128-gcm:8JCsHssyVTFyPy5lYdNhZg==@10.10.10.70:2447'
    trojan: 'trojan://testpass123@10.10.10.70:2446/?sni=hy2.test&allowInsecure=1'
}

group {
    hy2 {
        filter: name(hy2)
        policy: fixed(0)
    }
    tuic {
        filter: name(tuic)
        policy: fixed(0)
    }
    ss2022 {
        filter: name(ss2022)
        policy: fixed(0)
    }
    trojan {
        filter: name(trojan)
        policy: fixed(0)
    }
}

routing {
    dport(8443, 2444, 2446, 2447) -> direct(must)
    dport(5201, 8001, 53531) -> hy2
    dport(5202, 8002, 53532) -> tuic
    dport(5203, 8003, 53533) -> ss2022
    dport(5204, 8004, 53534) -> trojan
    fallback: direct
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: alidns
        }
    }
}
