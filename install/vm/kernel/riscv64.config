# QEMU virt: the device tree describes fw_cfg (qemu,fw-cfg-mmio) and virtio-mmio.
CONFIG_ARCH_VIRT=y
CONFIG_MMU=y
# The musl target uses the double-float ABI.
CONFIG_FPU=y
CONFIG_OF=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VIRTIO_MMIO=y
# Without HAVE_EFFICIENT_UNALIGNED_ACCESS the verifier enforces strict packet
# alignment and rejects honk's TC programs; QEMU handles unaligned accesses.
CONFIG_NONPORTABLE=y
CONFIG_RISCV_EFFICIENT_UNALIGNED_ACCESS=y
