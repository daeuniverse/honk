# QEMU q35 (direct kernel boot) and bhyve (UEFI): ACPI describes fw_cfg as QEMU0002
# and the virtio devices sit on PCI.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_KERNEL_ZSTD=y
